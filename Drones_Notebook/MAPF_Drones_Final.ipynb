def pick_agents(df, n):
    # First n entries (file order) with distinct starts, distinct goals and a reachable goal.
    chosen, starts, goals = [], set(), set()
    for r in df.itertuples():
        s, g = (r.sx, r.sy), (r.gx, r.gy)
        if s != g and s not in starts and g not in goals and Planner(env).plan(s, g) is not None:   # distinct and reachable
            chosen.append(r); starts.add(s); goals.add(g)
        if len(chosen) == n:
            break
    return pd.DataFrame(chosen).drop(columns="Index").reset_index(drop=True)

